# VibedInsight Configuration
# Copy this file to .env and adjust values

# Domain (same as in /srv/ai-lab/.env)
DOMAIN=your-domain.com

# Timezone
TZ=Europe/Berlin

# PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# API key protecting all endpoints except /health (single-user auth).
# Generate with: openssl rand -hex 32
# The same key goes into the app's settings screen.
API_KEY=CHANGE_ME_TO_RANDOM_API_KEY

# Ollama models (optional, defaults shown)
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# Allow saving URLs that resolve to private/LAN addresses (default: false)
# ALLOW_PRIVATE_URLS=true

# Auto-generate the weekly digest on Sunday evenings (default: true)
# WEEKLY_AUTO_GENERATE=false
